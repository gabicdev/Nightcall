{
  "name": "nightcall",
  "version": "13.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "build": "node scripts/build.js",
    "test:accounts": "node tests/accounts-browser.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "check:desktop": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/remote-config.cjs && node --check desktop/runtime-config.cjs",
    "diagnose:resources": "node scripts/resources.mjs",
    "check:release": "node scripts/validate-release.cjs",
    "diagnose:network": "node scripts/healthcheck.mjs",
    "smoke:network": "node scripts/healthcheck.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "productName": "Nightcall",
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nightcall.desktop",
    "productName": "Nightcall",
    "asar": false,
    "files": [
      "index.html",
      "js/**/*",
      "css/**/*",
      "assets/**/*",
      "backend/**/*",
      "desktop/**/*",
      "package.json",
      "CONFIGURAR-NIGHTCALL-WINDOWS.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Nightcall-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Nightcall-Portable-${version}-${arch}.${ext}"
    }
  }
}
