# Configurar somente em servidor remoto com HTTPS ativo (Caddy/nginx).
NIGHTCALL_HOST=127.0.0.1
PORT=3000
NIGHTCALL_PUBLIC_ORIGIN=https://chat.exemplo.com
NIGHTCALL_DATABASE=/var/lib/nightcall/nightcall.sqlite
# Um servidor TURN dedicado e credenciais reais são necessários para redes restritas.
# Nunca publicar credenciais TURN de longo prazo em repositórios ou clientes.
# NIGHTCALL_ICE_SERVERS_JSON=[{"urls":"turn:turn.exemplo.com:3478","username":"usuario-temporario","credential":"senha-temporaria"}]
